# --- Хранилище ---
RADAR_DB=./data/radar.db

# --- ЕФРСБ / Федресурс (первоисточник по 127-ФЗ) ---
# Ключ выдаётся по договору с оператором реестра. Есть бесплатный лимит на небольшой объём запросов.
# ВАЖНО: пути эндпоинтов и имена полей сверьте со спецификацией той версии, что выдана вам
# (актуальная на момент написания — «Сервис получения сведений из ЕФРСБ (REST API)» v1.3.0).
FEDRESURS_ENABLED=false
FEDRESURS_BASE_URL=https://bank-publications-prod.fedresurs.ru
FEDRESURS_KEY=
# Путь метода поиска сообщений и имя заголовка авторизации — вынесены в конфиг,
# потому что различаются между версиями спецификации.
FEDRESURS_SEARCH_PATH=/v1/messages
FEDRESURS_AUTH_HEADER=Authorization

# --- ГИС Торги (гос/мун имущество, аренда, арестованное имущество; НЕ банкротство) ---
TORGI_GOV_ENABLED=true
TORGI_GOV_BASE_URL=https://torgi.gov.ru

# --- Telegram-алерты ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Пороги алертов ---
ALERT_MIN_SCORE=65
ALERT_MAX_PER_RUN=15

# --- Фильтр воронки ---
# Коды регионов через запятую (77 = Москва, 50 = МО, 78 = СПб). Пусто = все регионы.
FILTER_REGIONS=
# Виды имущества через запятую: real_estate,land,vehicle,equipment,claim,share,other. Пусто = все.
FILTER_ASSET_KINDS=
FILTER_MIN_PRICE=
FILTER_MAX_PRICE=

# --- Воронка сделок и сроки ---
# Сроки считаются назад от окончания приёма заявок, в РАБОЧИХ днях:
# банковский перевод задатка не идёт в выходные.
DEAL_DEPOSIT_LEAD_DAYS=3
DEAL_DOCUMENTS_LEAD_DAYS=3
DEAL_APPLICATION_LEAD_DAYS=1
DEAL_REMIND_HORIZON_HOURS=72

# Праздничные дни через запятую: 2027-01-01,2027-01-02.
# Производственный календарь не зашит в код — переносы меняются ежегодно,
# а устаревший зашитый календарь опаснее его отсутствия: он выглядит точным.
HOLIDAYS=

# --- Обогащение данными реестров ---
# Запросы к реестрам платные, поэтому обогащаются не все лоты, а только кандидаты,
# прошедшие первый (бесплатный) проход скоринга.
ENRICH_MIN_SCORE=55
ENRICH_LIMIT=50
# Потолок платных запросов за один прогон — страховка от ошибки в логике отбора.
ENRICH_MAX_REQUESTS=100

# Факты, проверенные вручную. Работает без всяких API и не тратит бюджет запросов.
# Формат: { "77:06:0004009:1234": [ { "code": "egrn.encumbrance.none", "value": true } ] }
ENRICH_MANUAL_FACTS=

# ЕГРН по кадастровому номеру. Открытого официального API нет — доступ идёт через
# партнёрские сервисы, у каждого своя схема ответа. Разбор ответа — в функции
# factsFromEgrnResponse (src/enrich/providers.ts), под своего провайдера правится только она.
EGRN_ENABLED=false
EGRN_BASE_URL=
EGRN_PATH=/v1/objects
EGRN_SUBJECT_PARAM=cadastralNumber
EGRN_AUTH_HEADER=Authorization
EGRN_KEY=
EGRN_TTL_DAYS=30

# Реестр залогов движимого имущества ФНП по VIN. Главная проверка для транспорта:
# залог не прекращается при продаже сам по себе.
FNP_ENABLED=false
FNP_BASE_URL=
FNP_PATH=/v1/pledges
FNP_SUBJECT_PARAM=vin
FNP_AUTH_HEADER=Authorization
FNP_KEY=
FNP_TTL_DAYS=7

# --- Оценка ---
# Множитель к медиане цен реализации сопоставимых лотов.
# 1.0 = оценка «за сколько такой лот реально уходит с торгов».
# Поднимайте выше 1.0, только если у вас есть подтверждённые данные о рыночной премии.
ESTIMATE_UPLIFT=1.0
# Минимум сопоставимых сделок, ниже которого оценка не выдаётся.
ESTIMATE_MIN_COMPARABLES=5
