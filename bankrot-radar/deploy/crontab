# Расписание bankrot-radar для bare-metal установки.
# Поставить: crontab deploy/crontab (предварительно поправив пути).
#
# Две строки вместо шести: порядок фаз и защита от наложения прогонов —
# внутри run-cycle.sh, а не в расписании. Пять независимых записей в cron
# рано или поздно разъедутся, и алерты пойдут по вчерашним баллам.

RADAR_DIR=/opt/bankrot-radar
PATH=/usr/local/bin:/usr/bin:/bin

# Основной цикл: сбор, скоринг, обогащение, алерты, напоминания.
*/15 * * * * $RADAR_DIR/deploy/run-cycle.sh >> /var/log/bankrot-radar.log 2>&1

# Результаты состоявшихся торгов — обучающая выборка для оценки.
# Раз в неделю и с широким окном: сообщение о результатах публикуется
# через месяцы после самих торгов, чаще собирать нечего.
0 4 * * 0 cd $RADAR_DIR && npm run --silent radar -- harvest --days 180 >> /var/log/bankrot-radar.log 2>&1

# Раз в месяц — отчёт о полноте извлечения. Правила молча перестают срабатывать
# при смене формулировок, и заметить это можно только регулярной проверкой.
0 5 1 * * cd $RADAR_DIR && npm run --silent radar -- doctor >> /var/log/bankrot-radar-doctor.log 2>&1
